<!doctype html>
<html lang="es" data-theme="<%= publicTheme === 'dark' ? 'dark' : 'light' %>" data-authenticated="false" data-theme-server="true">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Estado del prorrateo <%= receipt.receipt_number %> | VecinosApp</title>
  <link rel="icon" href="/favicon.ico?v=<%= assetVersion %>" type="image/webp">
  <link rel="shortcut icon" href="/favicon.ico?v=<%= assetVersion %>" type="image/webp">
  <link rel="icon" type="image/webp" sizes="32x32" href="/favicon/favicon-32x32.webp">
  <link rel="stylesheet" href="/css/styles.css?v=<%= assetVersion %>">
</head>
<body class="public-body">
<header class="public-topbar">
  <div class="public-topbar-inner">
    <div class="public-brand">
      <img src="/favicon/icon-64x64.webp" alt="" width="32" height="32">
      <span>VecinosApp</span>
    </div>
    <div class="public-topbar-actions">
      <span class="public-view-label">Consulta pública</span>
      <button class="theme-toggle public-theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Activar tema oscuro" title="Activar tema oscuro">
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.752 15.002A9.718 9.718 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75a9.718 9.718 0 0 1 .748-3.752A9.753 9.753 0 1 0 21.752 15.002Z"></path></svg>
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
      </button>
    </div>
  </div>
</header>
<main class="container public-container">
<div id="publicAllocationView" class="allocation-share-view public-share-view">
  <section class="page-head public-page-head">
    <h1>Estado del prorrateo</h1>
    <span class="badge muted">Solo lectura</span>
  </section>
  <div class="detail public-summary-card">
    <div class="public-summary-total"><span>Monto total</span><strong>S/ <%= money(receipt.total_amount_cents) %></strong></div>
    <div class="public-summary-grid">
      <p><span>Edificio</span><strong><%= receipt.building_name || "-" %></strong></p>
      <p><span>Recibo</span><strong><%= receipt.receipt_number %></strong></p>
      <p><span>Servicio</span><strong><%= receipt.service_type %></strong></p>
      <p><span>Periodo</span><strong><%= receipt.period %></strong></p>
    </div>
    <% if (receipt.consumption_total_milli > 0) { %>
      <p class="public-consumption"><span>Consumo total</span><strong><%= consumption(receipt.consumption_total_milli) %> <%= receipt.consumption_unit || "" %></strong></p>
    <% } %>
  </div>
  <h2>Prorrateo actual</h2>
  <% if (allocationsByFloor.length) { %>
    <div class="accordion-list">
      <% allocationsByFloor.forEach((floor) => { %>
        <details class="floor-accordion public-floor" open>
          <summary>
            <span class="floor-title">Piso <%= floor.floor %></span>
            <span class="floor-meta"><%= floor.allocations.length %> ocupante<%= floor.allocations.length === 1 ? "" : "s" %></span>
            <span class="floor-totals allocation-floor-totals">
              <span>Asignado S/ <%= money(floor.assigned_amount_cents) %></span>
              <span>Pagado S/ <%= money(floor.paid_amount_cents) %></span>
              <span>Saldo S/ <%= money(floor.balance_cents) %></span>
            </span>
          </summary>
          <table class="compact-table mobile-cards public-allocation-table">
            <thead><tr><th>Unidad</th><th>Ocupante</th><th>Consumo</th><th>Asignado</th><th>Pagado</th><th>Saldo</th><th>Estado</th></tr></thead>
            <tbody>
              <% floor.allocations.forEach((allocation) => { %>
                <tr>
                  <td data-label="Unidad"><%= allocation.unit %></td>
                  <td data-label="Ocupante"><%= allocation.full_name %></td>
                  <td data-label="Consumo"><%= allocation.consumption_milli ? `${consumption(allocation.consumption_milli)} ${receipt.consumption_unit || ""}` : "-" %></td>
                  <td data-label="Asignado">S/ <%= money(allocation.assigned_amount_cents) %></td>
                  <td data-label="Pagado">S/ <%= money(allocation.paid_amount_cents) %></td>
                  <td data-label="Saldo">S/ <%= money(allocation.balance_cents) %></td>
                  <td data-label="Estado"><span class="badge status-badge <%= statusClass(allocation.status) %>"><%= allocation.status %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </details>
      <% }) %>
    </div>
  <% } else { %>
    <div class="detail">Este recibo aún no fue prorrateado.</div>
  <% } %>
</div>
<div class="share-toolbar public-share-actions" data-share-path="<%= sharePath %>" data-share-title="Estado del prorrateo <%= receipt.receipt_number %>">
  <button class="button" type="button" data-share-native>Compartir</button>
  <button class="button secondary" type="button" data-share-whatsapp>WhatsApp</button>
  <button class="button secondary" type="button" data-capture-target="publicAllocationView">Capturar y compartir</button>
  <span class="share-status" data-share-status role="status" aria-live="polite"></span>
</div>
</main>
<script src="/js/main.js?v=<%= assetVersion %>" defer></script>
</body>
</html>