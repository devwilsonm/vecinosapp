<%- include("../partials/header", { title: "Deudas por ocupante | VecinosApp", pageClass: "occupant-debts-page", pageStyles: ["charts","occupant-debts"] }) %>
<section class="page-head"><h1>Deudas pendientes por ocupante</h1><a class="debt-report-actions" href="/reports">Volver al resumen</a></section>
<form class="receipt-filters debt-report-actions" method="get" data-partial-filter action="/reports/occupant-debts">
  <div class="debt-occupant-picker">
    <label for="debtOccupantSearch">Ocupante</label>
    <% const occupantLabel = (row) => `${row.full_name} · ${row.building_name || "Sin edificio"} · Piso ${row.floor} · Unidad ${row.unit}${row.is_active ? "" : " (inactivo)"}`; %>
    <input id="debtOccupantSearch" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="debtOccupants" data-debt-occupant-search placeholder="Escribe el nombre del ocupante" value="<%= occupant ? occupantLabel(occupant) : "" %>" autocomplete="off" required>
    <input type="hidden" name="occupant_id" data-debt-occupant-id value="<%= occupant ? selectedOccupantId : "" %>">
    <div id="debtOccupants" class="debt-occupant-options" role="listbox" aria-label="Ocupantes" hidden>
      <% occupants.forEach((row) => { %>
        <div id="debt-occupant-<%= row.id %>" class="debt-occupant-option" role="option" aria-selected="false" data-occupant-id="<%= row.id %>"><%= occupantLabel(row) %></div>
      <% }) %>
      <div class="debt-occupant-empty" role="status" hidden>No se encontraron ocupantes.</div>
    </div>
  </div>
  <div class="receipt-filters-actions"><button class="button" type="submit">Ver deudas</button></div>
</form>
<div data-partial-results>
<% if (occupant) { %>
  <section aria-label="Reporte del ocupante" data-occupant-report>
    <div class="page-head">
      <div><h2><%= occupant.full_name %></h2><p><%= occupant.building_name || "Sin edificio" %> · Piso <%= occupant.floor %> · Unidad <%= occupant.unit %></p></div>
      <% if (periods.length || evolutionCharts.length) { %><button class="button secondary debt-report-actions" type="button" data-print-debt-report>Imprimir / Guardar PDF</button><% } %>
    </div>
    <div class="tabs debt-report-actions" role="tablist" aria-label="Información del ocupante" data-report-tabs>
      <button class="tab-button active" id="occupant-debts-tab" type="button" role="tab" aria-controls="occupant-debts-panel" aria-selected="true" data-tab-target="occupant-debts-panel">Deudas</button>
      <button class="tab-button" id="occupant-evolution-tab" type="button" role="tab" aria-controls="occupant-evolution-panel" aria-selected="false" tabindex="-1" data-tab-target="occupant-evolution-panel">Evolución</button>
    </div>
    <div class="tab-panel active" id="occupant-debts-panel" role="tabpanel" aria-labelledby="occupant-debts-tab" tabindex="0">
    <% periods.forEach((group) => { %>
      <h2><%= group.period %></h2>
      <div class="debt-report-table">
        <table>
          <thead><tr><th scope="col">Recibo</th><th scope="col">Servicio</th><th scope="col" class="debt-amount">Asignado</th><th scope="col" class="debt-amount">Pagado</th><th scope="col" class="debt-amount">Pendiente</th></tr></thead>
          <tbody><% group.receipts.forEach((receipt) => { %>
            <tr><td><%= receipt.receipt_number %></td><td><%= serviceLabels[receipt.service_type] || receipt.service_type %></td><td class="debt-amount">S/ <%= money(receipt.assigned_amount_cents) %></td><td class="debt-amount">S/ <%= money(receipt.paid_amount_cents) %></td><td class="debt-amount debt-balance">S/ <%= money(receipt.balance_cents) %></td></tr>
          <% }) %></tbody>
          <tfoot><tr><th scope="row" colspan="4">Subtotal del período</th><td class="debt-amount"><strong>S/ <%= money(group.balance_cents) %></strong></td></tr></tfoot>
        </table>
      </div>
    <% }) %>
    <% if (periods.length) { %><p class="detail debt-report-total"><strong>Total pendiente</strong><strong class="debt-amount">S/ <%= money(totalBalanceCents) %></strong></p><% } else { %><p class="detail">Este ocupante no tiene deudas pendientes.</p><% } %>
    </div>
    <div class="tab-panel" id="occupant-evolution-panel" role="tabpanel" aria-labelledby="occupant-evolution-tab" tabindex="0" hidden>
      <h2>Evolución del gasto en servicios</h2>
      <p>Seis meses hasta su última asignación reciente · Monto asignado al ocupante, haya pagado o no. Cada columna muestra el total del período en soles, desglosado por servicio.</p>
      <p class="field-help">Incluye cuotas fijas y servicios medidos. Se usa el período del recibo; si no identifica un mes, se usa su fecha de emisión. El intervalo termina en el último mes con asignaciones dentro de los seis meses recientes. Los meses sin cargos dentro del intervalo se muestran en cero.</p>
      <% if (evolutionCharts.length) { %>
        <section class="consumption-chart-panel">
          <div class="consumption-chart-heading"><div><h3>Gasto mensual en soles (S/)</h3><span><%= evolutionCharts.map((report) => report.label).join(" · ") %></span></div></div>
          <div id="occupant-evolution-chart-0" class="consumption-chart" role="img" aria-label="Montos mensuales asignados en soles por todos los servicios del ocupante"></div>
        </section>
        <details class="occupant-consumption-values">
          <summary>Ver valores por período</summary>
          <div class="debt-report-table"><table><thead><tr><th scope="col">Período</th><% evolutionCharts.forEach((report) => { %><th scope="col"><%= report.label %></th><% }) %><th scope="col">Total</th></tr></thead><tbody>
          <% evolutionCharts[0].data.forEach((point, index) => { %><tr><th scope="row"><%= point.category %></th><% evolutionCharts.forEach((report) => { %><td>S/ <%= money(Math.round(report.data[index].value * 100)) %></td><% }) %><td><strong>S/ <%= money(evolutionCharts.reduce((total, report) => total + Math.round(report.data[index].value * 100), 0)) %></strong></td></tr><% }) %>
          </tbody></table></div>
        </details>
        <script id="occupantEvolutionData" type="application/json"><%- JSON.stringify([evolutionCharts]).replace(/</g, '\\u003c') %></script>
      <% } else { %>
        <p class="detail">Este ocupante no tiene montos asignados por servicios en los últimos seis meses.</p>
      <% } %>
    </div>
  </section>
<% } else { %>
  <p class="detail"><%= occupants.length ? "Selecciona un ocupante para consultar todos sus recibos pendientes." : "No hay ocupantes disponibles." %></p>
<% } %>
</div>
<%- include("../partials/footer", { pageScripts: ["consumption-chart","tabs","occupant-debts"] }) %>