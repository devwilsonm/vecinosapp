<%- include("../partials/header", { title: "Deudas por ocupante | VecinosApp", pageClass: "occupant-debts-page" }) %>
<section class="page-head"><h1>Deudas pendientes por ocupante</h1><a class="debt-report-actions" href="/reports">Volver al resumen</a></section>
<form class="receipt-filters debt-report-actions" method="get" action="/reports/occupant-debts">
  <label>Ocupante
    <% const occupantLabel = (row) => `${row.full_name} · ${row.building_name || "Sin edificio"} · Piso ${row.floor} · Unidad ${row.unit}${row.is_active ? "" : " (inactivo)"}`; %>
    <input type="text" list="debtOccupants" data-debt-occupant-search placeholder="Escribe el nombre del ocupante" value="<%= occupant ? occupantLabel(occupant) : "" %>" autocomplete="off" required>
    <input type="hidden" name="occupant_id" data-debt-occupant-id value="<%= occupant ? selectedOccupantId : "" %>">
    <datalist id="debtOccupants">
      <% occupants.forEach((row) => { %>
        <option value="<%= occupantLabel(row) %>" data-occupant-id="<%= row.id %>"></option>
      <% }) %>
    </datalist>
  </label>
  <div class="receipt-filters-actions"><button class="button" type="submit">Ver deudas</button></div>
</form>
<% if (occupant) { %>
  <section aria-label="Estado de deuda">
    <div class="page-head">
      <div><h2><%= occupant.full_name %></h2><p><%= occupant.building_name || "Sin edificio" %> · Piso <%= occupant.floor %> · Unidad <%= occupant.unit %></p></div>
      <% if (periods.length) { %><button class="button secondary debt-report-actions" type="button" data-print-debt-report>Imprimir / Guardar PDF</button><% } %>
    </div>
    <% periods.forEach((group) => { %>
      <h2><%= group.period %></h2>
      <div class="debt-report-table">
        <table>
          <thead><tr><th scope="col">Recibo</th><th scope="col">Servicio</th><th scope="col" class="debt-amount">Asignado</th><th scope="col" class="debt-amount">Pagado</th><th scope="col" class="debt-amount">Pendiente</th></tr></thead>
          <tbody><% group.receipts.forEach((receipt) => { %>
            <tr><td><%= receipt.receipt_number %></td><td><%= serviceLabels[receipt.service_type] || receipt.service_type %></td><td class="debt-amount">S/ <%= money(receipt.assigned_amount_cents) %></td><td class="debt-amount">S/ <%= money(receipt.paid_amount_cents) %></td><td class="debt-amount debt-balance">S/ <%= money(receipt.balance_cents) %></td></tr>
          <% }) %></tbody>
          <tfoot><tr><th scope="row" colspan="4">Subtotal del período</th><td class="debt-amount"><strong>S/ <%= money(group.balance_cents) %></strong></td></tr></tfoot>
        </table>
      </div>
    <% }) %>
    <% if (periods.length) { %><p class="detail debt-report-total"><strong>Total pendiente</strong><strong class="debt-amount">S/ <%= money(totalBalanceCents) %></strong></p><% } else { %><p class="detail">Este ocupante no tiene deudas pendientes.</p><% } %>
  </section>
<% } else { %>
  <p class="detail"><%= occupants.length ? "Selecciona un ocupante para consultar todos sus recibos pendientes." : "No hay ocupantes disponibles." %></p>
<% } %>
<%- include("../partials/footer") %>