<%- include("../partials/public-header", { title: "Reporte público de consumo | VecinosApp" }) %>
  <section class="page-head public-page-head">
    <h1>Reporte de consumo</h1>
    <span class="badge muted">Solo lectura</span>
  </section>
  <div class="detail public-summary-card">
    <div class="public-summary-grid">
      <p><span>Periodo</span><strong><%= selectedFrom %> a <%= selectedTo %></strong></p>
      <p><span>Servicio</span><strong><%= serviceLabel %></strong></p>
      <p><span>Edificio</span><strong><%= buildingLabel %></strong></p>
      <p><span>Enlace</span><strong>Válido por 24 horas</strong></p>
    </div>
  </div>
  <% if (consumptionCharts.length) { %>
    <div class="consumption-chart-list">
      <% consumptionCharts.forEach((report) => { %>
        <section class="consumption-chart-panel">
          <div class="consumption-chart-heading">
            <div>
              <h2><%= report.label %></h2>
              <span>Consumo mensual en <%= report.unit %></span>
            </div>
          </div>
          <div id="consumption-chart-<%= report.service %>" class="consumption-chart" role="img" aria-label="Consumo mensual de <%= report.label %> en <%= report.unit %>"></div>
        </section>
      <% }) %>
    </div>
    <script id="consumptionReportData" type="application/json"><%- JSON.stringify(consumptionCharts) %></script>
  <% } else { %>
    <div class="detail">No hay consumos registrados para el intervalo seleccionado.</div>
  <% } %>
</main>
<script src="/js/theme.js?v=<%= assetVersion %>" defer></script>
<% if (consumptionCharts.length) { %>
<script src="/js/consumption-chart.js?v=<%= assetVersion %>" defer></script>
<% } %>
</body>
</html>