<%- include("../partials/header", { title: `Pagos del piso ${floor} | VecinosApp` }) %>
<section class="page-head">
  <div>
    <h1>Pagos del piso <%= floor %></h1>
    <p class="page-subtitle"><%= building.name %></p>
  </div>
  <span class="badge muted"><%= allocations.length %> deuda<%= allocations.length === 1 ? "" : "s" %> pendiente<%= allocations.length === 1 ? "" : "s" %></span>
</section>
<%- include("../partials/errors", { errors }) %>
<% if (!allocations.length) { %>
  <div class="detail mass-payment-empty">
    <h2>No hay deudas pendientes</h2>
    <p>Todos los ocupantes de este piso están al día.</p>
    <a class="button" href="/payments?building_id=<%= building.id %>">Volver a pagos</a>
  </div>
<% } else { %>
  <form method="post" action="/payments/mass" class="form mass-payment-form" data-mass-payment-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="building_id" value="<%= building.id %>">
    <input type="hidden" name="floor" value="<%= floor %>">
    <section class="detail mass-payment-summary">
      <div>
        <strong>Pago total del lote</strong>
        <span data-mass-payment-count><%= allocations.length %> deudas seleccionadas</span>
      </div>
      <strong class="mass-payment-total" data-mass-payment-total>S/ <%= money(allocations.reduce((total, allocation) => total + Number(allocation.balance_cents || 0), 0)) %></strong>
    </section>
    <fieldset class="wide mass-payment-selection">
      <legend>Deudas a pagar</legend>
      <label class="check mass-select-all"><input type="checkbox" data-mass-select-all checked> Seleccionar todas</label>
      <div class="mass-payment-list">
        <% allocations.forEach((allocation) => { %>
          <label class="mass-payment-row">
            <input type="checkbox" name="allocation_ids" value="<%= allocation.id %>" data-mass-payment-check data-balance-cents="<%= allocation.balance_cents %>" <%= selectedIds.has(Number(allocation.id)) ? "checked" : "" %>>
            <span class="mass-payment-info"><strong>Unidad <%= allocation.unit %> · <%= allocation.full_name %></strong><span>Recibo <%= allocation.receipt_number %> · <%= allocation.period %></span></span>
            <strong>S/ <%= money(allocation.balance_cents) %></strong>
          </label>
        <% }) %>
      </div>
    </fieldset>
    <label>Fecha de pago <input type="date" name="payment_date" value="<%= formData.payment_date %>" required></label>
    <label>Método de pago
      <select name="payment_method" required>
        <option value="">Seleccionar</option>
        <% ["efectivo", "transferencia", "yape/plin", "otro"].forEach((method) => { %>
          <option value="<%= method %>" <%= formData.payment_method === method ? "selected" : "" %>><%= method %></option>
        <% }) %>
      </select>
    </label>
    <label class="wide">Observación <textarea name="note"><%= formData.note || "" %></textarea></label>
    <label class="check wide mass-payment-confirm"><input type="checkbox" required> Confirmo registrar el pago completo de las deudas seleccionadas</label>
    <div class="form-actions">
      <button class="button" type="submit" title="Registrar pagos seleccionados"><svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"></rect><path d="M3 10h18"></path><path d="M7 14h3"></path></svg><span>Registrar pagos</span></button>
      <a href="/payments?building_id=<%= building.id %>">Cancelar</a>
    </div>
  </form>
<% } %>
<%- include("../partials/footer") %>