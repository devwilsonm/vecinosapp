<%- include("../../partials/header", { title: "Usuarios | VecinosApp" }) %>
<div class="page-head">
  <h1>Usuarios</h1>
  <a class="button" href="/admin/users/new">Nuevo usuario</a>
</div>

<table class="mobile-cards">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Correo</th>
      <th>Perfil</th>
      <th>Edificios</th>
      <th>Estado</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% if (!users.length) { %>
      <tr><td colspan="6">No hay usuarios registrados.</td></tr>
    <% } %>
    <% users.forEach((user) => { %>
      <tr>
        <td data-label="Nombre"><%= user.full_name %></td>
        <td data-label="Correo"><%= user.email %></td>
        <td data-label="Perfil"><span class="badge"><%= user.role_name || "Sin perfil" %></span></td>
        <td data-label="Edificios"><%= user.building_count %></td>
        <td data-label="Estado"><span class="badge <%= user.is_active ? "ok" : "muted" %>"><%= user.is_active ? "Activo" : "Inactivo" %></span></td>
        <td class="actions user-actions" data-label="Acciones">
          <a class="icon-action" href="/admin/users/<%= user.id %>/edit" title="Editar usuario" aria-label="Editar usuario"><svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg></a>
          <% if (user.is_active && currentUser.id !== user.id) { %>
            <form method="post" action="/admin/users/<%= user.id %>/deactivate" class="confirmable" data-confirm="¿Desactivar este usuario?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="icon-action" type="submit" title="Desactivar usuario" aria-label="Desactivar usuario"><svg class="action-icon action-icon-disable" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m6 6 12 12"></path></svg></button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include("../../partials/footer") %>