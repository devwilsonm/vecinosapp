<%- include("../../partials/header", { title: title + " | VecinosApp" }) %>
<h1><%= title %></h1>
<%- include("../../partials/errors", { errors }) %>

<form method="post" action="<%= user.id ? "/admin/users/" + user.id + "?_method=PUT" : "/admin/users" %>" class="form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <label>Nombre completo
    <input type="text" name="full_name" value="<%= user.full_name || "" %>" required>
  </label>

  <label>Correo electrónico
    <input type="email" name="email" value="<%= user.email || "" %>" required>
  </label>

  <label class="user-role-field">
    <span class="field-label-with-action">
      <span>Perfil</span>
      <button type="button" class="role-info-trigger" data-role-info-open title="Ver información de perfiles" aria-label="Ver información de perfiles">
        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5"></path><circle cx="12" cy="7.5" r=".8" fill="currentColor" stroke="none"></circle></svg>
      </button>
    </span>
    <select name="role_id" required>
      <option value="">Seleccionar perfil</option>
      <% roles.forEach((role) => { %>
        <option value="<%= role.id %>" <%= Number(user.role_id) === Number(role.id) ? "selected" : "" %>><%= role.name %></option>
      <% }) %>
    </select>
  </label>

  <label>Contraseña <%= user.id ? "(dejar vacío para no cambiar)" : "" %>
    <input type="password" name="password" <%= user.id ? "" : "required" %> minlength="6">
  </label>

  <label class="check">
    <input type="checkbox" name="is_active" value="1" <%= user.is_active === 0 ? "" : "checked" %>> Activo
  </label>

  <div class="wide">
    <h2>Edificios asignados</h2>
    <div class="check-grid">
      <% if (!buildings.length) { %>
        <p>No hay edificios activos.</p>
      <% } %>
      <% buildings.forEach((building) => { %>
        <label class="check item">
          <input type="checkbox" name="building_ids" value="<%= building.id %>" <%= assignedBuildings.includes(building.id) ? "checked" : "" %>>
          <span><%= building.name %></span>
        </label>
      <% }) %>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" title="Guardar usuario"><svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h12l2 2v14H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"></path><path d="M7 4v5h8V4"></path><path d="M8 20v-6h8v6"></path></svg><span>Guardar</span></button>
    <a href="/admin/users">Cancelar</a>
  </div>
</form>
<div class="role-info-modal" id="roleInfoModal" hidden>
  <div class="role-info-modal-backdrop" data-role-info-close></div>
  <section class="role-info-dialog" role="dialog" aria-modal="true" aria-labelledby="roleInfoTitle" tabindex="-1">
    <div class="role-info-dialog-header">
      <h2 id="roleInfoTitle">Perfiles de usuario</h2>
      <button type="button" class="icon-action role-info-close" data-role-info-close title="Cerrar información de perfiles" aria-label="Cerrar información de perfiles">
        <svg class="action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12"></path><path d="m18 6-12 12"></path></svg>
      </button>
    </div>
    <div class="role-info-list">
      <article class="role-info-item"><h3>Super Admin</h3><p>Acceso total a la aplicación.</p></article>
      <article class="role-info-item"><h3>Administrador</h3><p>Administra la operación general sin mantenimiento crítico.</p></article>
      <article class="role-info-item"><h3>Propietario</h3><p>Gestiona edificios asignados, ocupantes, pisos, recibos y pagos.</p></article>
      <article class="role-info-item"><h3>Operador</h3><p>Registra información operativa con permisos limitados.</p></article>
    </div>
  </section>
</div>
<%- include("../../partials/footer") %>
