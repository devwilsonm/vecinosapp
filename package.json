{
  "name": "vecinosapp",
  "version": "1.0.0",
  "description": "Aplicación web para administrar recibos, prorrateos y pagos de un edificio.",
  "main": "src/server.js",
  "scripts": {
    "start": "tsx src/server.ts",
    "start:prod": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.js",
    "review": "tsx scripts/review.js",
    "clear-data": "tsx scripts/clear-data.js",
