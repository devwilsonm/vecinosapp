{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleDetection": "force",
    "moduleResolution": "Node16",
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}